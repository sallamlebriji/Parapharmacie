DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/paraflow"
PORT=4100
JWT_SECRET="remplacez-par-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="12h"
# Production: frontend origin(s), comma-separated; * allows tenant storefronts on custom domains.
CORS_ORIGIN="http://localhost:5173"
# Mot de passe attribué aux comptes de démonstration par `npm run db:seed`
DEMO_PASSWORD="choisissez-un-mot-de-passe-de-test"
OPERATOR_EMAIL="operateur@paraflow.ma"
NODE_ENV="development"
